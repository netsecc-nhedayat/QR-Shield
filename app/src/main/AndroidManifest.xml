<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only permission: camera, requested when the user opens the scanner. No INTERNET. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.QRShield">

        <activity
            android:name=".ui.home.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.scanner.ScannerActivity"
            android:exported="false"
            android:label="@string/scanner_title" />
        <activity
            android:name=".ui.result.ResultActivity"
            android:exported="false"
            android:label="@string/result_title" />
        <activity
            android:name=".ui.manual.ManualAnalysisActivity"
            android:exported="false"
            android:label="@string/manual_title"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.privacy.PrivacyActivity"
            android:exported="false"
            android:label="@string/privacy_title" />
    </application>
</manifest>
