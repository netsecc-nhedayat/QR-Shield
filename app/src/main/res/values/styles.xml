<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.QRShield" parent="Theme.AppCompat">
        <item name="colorPrimary">@color/navy_800</item>
        <item name="colorPrimaryDark">@color/navy_900</item>
        <item name="colorAccent">@color/teal_500</item>
        <item name="android:windowBackground">@color/navy_900</item>
        <item name="android:statusBarColor">@color/navy_900</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Widget.QRShield.Button" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.QRShield.Button.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/on_accent</item>
    </style>
    <style name="Widget.QRShield.Button.Secondary">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Title" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Body" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
    <style name="Text.Caption" parent="">
        <item name="android:textColor">@color/teal_500</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/spacing_m</item>
        <item name="android:orientation">vertical</item>
    </style>
</resources>
