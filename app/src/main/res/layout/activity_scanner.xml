<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_900">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/scanner_hint" />

    <TextView
        android:id="@+id/status_text"
        style="@style/Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/navy_800"
        android:gravity="center"
        android:padding="@dimen/spacing_m"
        android:text="@string/scanner_hint"
        android:textColor="@color/text_primary" />

    <LinearLayout
        android:id="@+id/permission_panel"
        style="@style/Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="@dimen/screen_padding"
        android:visibility="gone">

        <TextView
            android:id="@+id/permission_title"
            style="@style/Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permission_title" />

        <TextView
            android:id="@+id/permission_message"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:text="@string/permission_message" />

        <Button
            android:id="@+id/permission_button"
            style="@style/Widget.QRShield.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:text="@string/permission_button_allow" />
    </LinearLayout>
</FrameLayout>
